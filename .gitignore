# Godot-generated caches and imports
/.godot/
/.mono/
*.import
# Atlas control images are CPU data, so their Keep File import policy is authored.
!/content/chapter_01/continent/land.png.import
!/content/chapter_01/continent/elevation.png.import
!/content/chapter_01/continent/water.png.import
!/content/chapter_01/continent/region.png.import

# C# / .NET build products
/.vs/
/.idea/
**/[Bb]in/
**/[Oo]bj/
/packages/

# Platform builds and exports
/android/
/build/
/builds/
/export/
/exports/

# Generated screenshots and render captures
/shots/*
!/shots/.gdignore
/screenshots/
/captures/
/renders/

# Reproducible world compiler output. Authored continent sources live beside
# this directory and remain tracked; sector artifacts are disposable caches.
/content/**/derived/

# Reference images are TRACKED on purpose. docs/RUINS.md and AGENTS.md both
# tell future sessions to look at world-new/ rather than trust a summary of it,
# so the images have to survive a fresh clone or that instruction is a lie.


# Editor and operating-system files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Temporary files, logs, and runtime crashes
*.tmp
*.log
mono_crash.*.json
